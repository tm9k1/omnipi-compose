ARG VERSION=latest
FROM tsl0922/ttyd:${VERSION}

# Single layer: update, upgrade, install deps, clean up
RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-venv \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/remote-shell \
    && python3 -m venv /opt/remote-shell/venv \
    && /opt/remote-shell/venv/bin/pip install --upgrade pip textual --no-cache-dir

COPY remote_shell.py /opt/remote-shell/remote_shell.py

# Pre-compile bytecode so Python won't attempt cache writes in the read_only container
RUN /opt/remote-shell/venv/bin/python -m compileall -q /opt/remote-shell/

ARG MAGIC_COMMAND="echo 'This is a magic command. If you see this, the remote shell is working.'"
ENV MAGIC_COMMAND=${MAGIC_COMMAND}

ARG TMOUT=300
ENV TMOUT=${TMOUT}

# REMOTE_SHELL_PASSWORD is NOT baked into the image — injected at runtime via env_file

ENTRYPOINT ["ttyd", "-W", "-w", "/home/ubuntu", "-p", "7681", "-t", "fontSize=14", "-t", "theme={'background':'#000000'}", "/opt/remote-shell/venv/bin/python", "/opt/remote-shell/remote_shell.py"]
