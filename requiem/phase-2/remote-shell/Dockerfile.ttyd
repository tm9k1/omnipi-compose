ARG VERSION=latest
FROM tsl0922/ttyd:${VERSION}

# Single layer: update, upgrade, install deps, clean up
RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-venv \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/remote-shell \
    && python3 -m venv /opt/remote-shell/venv \
    && /opt/remote-shell/venv/bin/pip install --upgrade pip textual --no-cache-dir

COPY remote_shell.py /opt/remote-shell/remote_shell.py
COPY docker-entrypoint-ttyd.sh /usr/local/bin/docker-entrypoint-ttyd.sh

# Pre-compile bytecode so Python won't attempt cache writes in the read_only container
RUN /opt/remote-shell/venv/bin/python -m compileall -q /opt/remote-shell/ \
    && chmod +x /usr/local/bin/docker-entrypoint-ttyd.sh

# MAGIC_COMMAND and REMOTE_SHELL_PASSWORD are NOT baked into the image.
# TTYD_IDLE_TIMEOUT (seconds) is optional; omit or set to 0 to disable.
# All three are injected at runtime via env_file.

ENTRYPOINT ["/usr/local/bin/docker-entrypoint-ttyd.sh"]
